<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNamaPerangkat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Perangkat"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_brown"/>

        <TextView
            android:id="@+id/tvAlamatPerangkat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00:00"
            android:textSize="13sp"
            android:textColor="@color/text_secondary_brown"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHubungkan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Hubungkan"
        android:textSize="14sp"
        android:textColor="@color/header_title_text"
        android:backgroundTint="@color/btn_simpan"
        app:cornerRadius="8dp"/>

</LinearLayout>