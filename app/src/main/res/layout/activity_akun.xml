<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_home"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER SIMPEL (tanpa tulisan Selamat Datang) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="50dp"
            android:paddingBottom="24dp"
            android:background="@color/header_bg">

            <ImageView
                android:id="@+id/ivKembali"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/panah"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Kembali"
                app:tint="@color/header_title_text"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Akun"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/header_title_text"/>
        </LinearLayout>

        <!-- CARD FOTO PROFIL -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/ivFotoAkun"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:src="@drawable/akun"
                    android:contentDescription="Foto Akun"/>

                <TextView
                    android:id="@+id/tvNamaAkun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nur lana"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_brown"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/tvRoleAkun"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:textColor="@color/text_secondary_brown"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD INFORMASI AKUN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFORMASI AKUN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textColor="@color/text_secondary_brown"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary_brown"/>

                <TextView
                    android:id="@+id/tvNama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nurlana"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary_brown"
                    android:layout_marginBottom="16dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/quick_menu_bg"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary_brown"/>

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="nurlana@email.com"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary_brown"
                    android:layout_marginBottom="16dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/quick_menu_bg"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Role"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary_brown"/>

                <TextView
                    android:id="@+id/tvRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary_brown"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TOMBOL KELUAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            android:text="Keluar"
            android:textSize="16sp"
            android:textColor="@color/header_title_text"
            android:backgroundTint="@color/header_bg"
            app:cornerRadius="16dp"/>

    </LinearLayout>
</ScrollView>